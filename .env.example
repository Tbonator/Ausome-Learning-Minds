# Local defaults. Copy to .env; never commit .env.
NODE_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:5173
PORT=3001
HOST=127.0.0.1
TRUST_PROXY=0
# Production: an absolute private directory OUTSIDE public_html and dist.
DATA_DIR=.local-data
# Generated by npm run admin:password. Back this up separately from the database.
DATA_ENCRYPTION_KEY=
ADMIN_USERNAME=owner
ADMIN_PASSWORD_HASH=

# Local preview saves applications but sends no email.
# Production requires MAIL_MODE=smtp and all SMTP values below.
MAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
APPLICATION_EMAIL=
# true attaches the full PDF (including sensitive details) to the school's email.
# false sends a reference and a link to the authenticated owner workspace.
EMAIL_ATTACH_PDF=false
